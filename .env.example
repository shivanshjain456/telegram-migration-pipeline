# ==============================================================================
# Telegram Migration Pipeline — Configuration Template
# ==============================================================================
# Obtain your API ID and API Hash from https://my.telegram.org -> API Development Tools
# Copy this file to .env. Never commit .env with real credentials.
# ==============================================================================

# Default Account Credentials
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef
SESSION_NAME=migration_session

# Optional Custom Storage Paths (defaults are local OS app-data directories)
# SESSION_DIR=./sessions
# RESUME_DIR=./resume
# LOG_DIR=./logs

# Rate Limiting & Throttling Defaults
# MIN_DELAY=1.0
# MAX_DELAY=3.0
# BATCH_SIZE=50
# FLOOD_WAIT_MAX_SLEEP=300

# Multi-Account Presets (Optional: Prefix matches session name uppercase)
# ACCOUNT1_API_ID=12345678
# ACCOUNT1_API_HASH=0123456789abcdef0123456789abcdef
# ACCOUNT2_API_ID=87654321
# ACCOUNT2_API_HASH=fedcba9876543210fedcba9876543210
